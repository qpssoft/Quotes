{
  "name": "quotes-admin",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.5",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:e2e": "npx ts-node --project tsconfig.test.json",
    "test:e2e:1": "npx ts-node --project tsconfig.test.json test1-email-login.ts",
    "test:e2e:2": "npx ts-node --project tsconfig.test.json test2-token-persistence.ts",
    "test:e2e:3": "npx ts-node --project tsconfig.test.json test3-protected-routes.ts",
    "test:e2e:4": "npx ts-node --project tsconfig.test.json test4-logout-flow.ts",
    "test:e2e:all": "npm run test:e2e:1 && npm run test:e2e:2 && npm run test:e2e:3 && npm run test:e2e:4",
    "test:bdd": "cross-env TS_NODE_PROJECT=tsconfig.test.json cucumber-js tests/features --require-module ts-node/register --require tests/**/*.ts",
    "test:bdd:debug": "SLOWMO=500 HEADLESS=false npm run test:bdd",
    "test:bdd:login": "cross-env TS_NODE_PROJECT=tsconfig.test.json cucumber-js tests/features/authentication.feature --require-module ts-node/register --require tests/**/*.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@types/node": "^24.10.1",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2"
  }
}
